{
   "action": {
      "default_icon": {
         "128": "/assets/logo-128.png",
         "48": "/assets/logo-48.png"
      }
   },
   "background": {
      "service_worker": "background.js"
   },
   "commands": {
      "screenshot-current-screen": {
         "description": "__MSG_command_screenshot_current_screen__",
         "suggested_key": {
            "default": "Ctrl+Shift+2",
            "mac": "MacCtrl+Shift+2"
         }
      },
      "screenshot-full-screen": {
         "description": "__MSG_command_screenshot_full_screen__",
         "suggested_key": {
            "default": "Ctrl+Shift+3",
            "mac": "MacCtrl+Shift+3"
         }
      },
      "screenshot-other-app": {
         "description": "__MSG_command_screenshot_other_app__",
         "suggested_key": {
            "default": "Ctrl+Shift+4",
            "mac": "MacCtrl+Shift+4"
         }
      },
      "screenshot-select-area": {
         "description": "__MSG_command_screenshot_select_area__",
         "suggested_key": {
            "default": "Ctrl+Shift+1",
            "mac": "MacCtrl+Shift+1"
         }
      }
   },
   "content_scripts": [ {
      "all_frames": true,
      "js": [ "content.js" ],
      "match_about_blank": true,
      "matches": [ "\u003Call_urls>" ],
      "run_at": "document_idle"
   } ],
   "default_locale": "en",
   "description": "__MSG_extension_description__",
   "externally_connectable": {
      "matches": [ "https://*.igenflow.com/*", "https://igenflow.com/*", "https://*.igenflow.ai/*", "https://igenflow.ai/*" ]
   },
   "host_permissions": [ "\u003Call_urls>" ],
   "icons": {
      "128": "/assets/logo-128.png",
      "48": "/assets/logo-48.png"
   },
   "key": "",
   "manifest_version": 3,
   "name": "__MSG_extension_name__",
   "permissions": [ "tabs", "tabGroups", "storage", "alarms", "sidePanel", "offscreen", "scripting", "webNavigation", "webRequest", "desktopCapture" ],
   "side_panel": {
      "default_path": "popup.html"
   },
   "update_url": "https://clients2.google.com/service/update2/crx",
   "version": "4.5.2",
   "web_accessible_resources": [ {
      "matches": [ "\u003Call_urls>" ],
      "resources": [ "popup.html", "local-flow.html", "editor.html", "editor.js", "offscreen.html", "offscreen.js", "microphone.html", "microphone.js", "assets/logo-48.png" ]
   } ]
}
