{
   "action": {
      "default_popup": "index.html",
      "default_title": "Highlighty"
   },
   "author": "Webmind Technologies LTD",
   "background": {
      "service_worker": "./static/js/background.js"
   },
   "commands": {
      "cmdf_kill_switch": {
         "description": "Toggle Highlighty's Cmd+F takeover (browser-level kill switch)",
         "suggested_key": {
            "default": "Ctrl+Shift+F",
            "mac": "Command+Shift+F"
         }
      }
   },
   "content_scripts": [ {
      "js": [ "./static/js/content.js" ],
      "matches": [ "\u003Call_urls>" ],
      "run_at": "document_start"
   } ],
   "content_security_policy": {
      "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
   },
   "description": "Searching and Multi Highlighting made effortless! It's the most efficient way to find and highlight any text on the web.",
   "devtools_page": "index.html",
   "host_permissions": [ "http://*/*", "https://*/*", "file:///*" ],
   "icons": {
      "128": "icon128.png",
      "16": "icon16.png",
      "48": "icon48.png"
   },
   "key": "",
   "manifest_version": 3,
   "name": "Highlighty: Search, Find, Multi Highlight",
   "options_ui": {
      "page": "index.html"
   },
   "permissions": [ "storage", "unlimitedStorage", "activeTab" ],
   "update_url": "https://clients2.google.com/service/update2/crx",
   "version": "2.4.8",
   "web_accessible_resources": [ {
      "matches": [ "\u003Call_urls>" ],
      "resources": [ "static/media/*", "static/fonts/*", "regex/regexSearch.worker.js" ]
   } ]
}
