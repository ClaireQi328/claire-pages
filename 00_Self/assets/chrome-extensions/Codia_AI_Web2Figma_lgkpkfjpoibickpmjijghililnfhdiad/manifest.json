      "96": "icons/icon-96.png"
   },
   "key": "",
   "manifest_version": 3,
   "name": "Codia AI Web2Figma: Import Web to Editable Figma",
   "permissions": [ "activeTab", "webNavigation", "scripting", "debugger", "downloads" ],
   "update_url": "https://clients2.google.com/service/update2/crx",
   "version": "0.0.1",
   "web_accessible_resources": [ {
      "matches": [ "\u003Call_urls>" ],
      "resources": [ "content.js" ]
   } ]
